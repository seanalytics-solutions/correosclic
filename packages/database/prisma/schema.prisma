generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     String            @id @default(uuid()) @db.Uuid
  email                  String            @unique @db.VarChar(255)
  passwordHash           String?
  nombre                 String            @db.VarChar(100)
  apellidoPaterno        String            @db.VarChar(100)
  apellidoMaterno        String?           @db.VarChar(100)
  telefono               String?           @db.VarChar(20)
  emailVerificado        Boolean           @default(false)
  activo                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  auditorias             Auditoria[]
  cliente                Cliente?
  cuentasExternas        CuentaExterna[]
  dispositivosPush       DispositivoPush[]
  empleado               Empleado?
  idempotencyKeys        IdempotencyKey[]
  notificaciones         Notificacion[]
  sesiones               Sesion[]
  usuarioRoles           UsuarioRol[]
  vendedor               Vendedor?
  //Se agregaron estas dos lineas -----------------------------------
  resetPasswordTokenHash String?           @db.VarChar(255)
  resetPasswordExpiresAt DateTime?

  @@index([activo])
  @@index([emailVerificado])
  @@map("usuarios")
}

model Rol {
  id           String       @id @default(uuid()) @db.Uuid
  codigo       String       @unique @db.VarChar(100)
  nombre       String       @db.VarChar(100)
  descripcion  String?
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  rolPermisos  RolPermiso[]
  usuarioRoles UsuarioRol[]

  @@map("roles")
}

model Permiso {
  id          String       @id @default(uuid()) @db.Uuid
  codigo      String       @unique @db.VarChar(150)
  nombre      String       @db.VarChar(150)
  descripcion String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rolPermisos RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  usuarioId  String   @db.Uuid
  rolId      String   @db.Uuid
  asignadoAt DateTime @default(now())
  rol        Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model RolPermiso {
  rolId     String  @db.Uuid
  permisoId String  @db.Uuid
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model Sesion {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @db.Uuid
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiraAt         DateTime
  revocadaAt       DateTime?
  createdAt        DateTime  @default(now())
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraAt])
  @@map("sesiones")
}

model CuentaExterna {
  id                 String           @id @default(uuid()) @db.Uuid
  usuarioId          String           @db.Uuid
  proveedor          ProveedorExterno
  proveedorUsuarioId String           @db.VarChar(255)
  email              String?          @db.VarChar(255)
  nombreMostrar      String?          @db.VarChar(255)
  avatarUrl          String?
  createdAt          DateTime         @default(now())
  usuario            Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proveedor, proveedorUsuarioId])
  @@index([usuarioId])
  @@map("cuentas_externas")
}

model Pais {
  id                String            @id @default(uuid()) @db.Uuid
  nombre            String            @unique @db.VarChar(100)
  codigoIso2        String            @unique @db.Char(2)
  codigoIso3        String            @unique @db.Char(3)
  activo            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  direcciones       Direccion[]
  estadosProvincias EstadoProvincia[]

  @@index([activo])
  @@map("paises")
}

model Region {
  id                String            @id @default(uuid()) @db.Uuid
  nombre            String            @unique @db.VarChar(100)
  descripcion       String?
  activo            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  estadosProvincias EstadoProvincia[]

  @@index([activo])
  @@map("regiones")
}

model EstadoProvincia {
  id          String      @id @default(uuid()) @db.Uuid
  paisId      String      @db.Uuid
  regionId    String?     @db.Uuid
  nombre      String      @db.VarChar(100)
  codigo      String?     @db.VarChar(20)
  latitud     Decimal?    @db.Decimal(11, 8)
  longitud    Decimal?    @db.Decimal(12, 8)
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ciudades    Ciudad[]
  direcciones Direccion[]
  vendedores  Vendedor[]
  pais        Pais        @relation(fields: [paisId], references: [id])
  region      Region?     @relation(fields: [regionId], references: [id])

  @@unique([paisId, nombre])
  @@index([paisId])
  @@index([regionId])
  @@index([activo])
  @@map("estados_provincias")
}

model Ciudad {
  id                String          @id @default(uuid()) @db.Uuid
  estadoProvinciaId String          @db.Uuid
  nombre            String          @db.VarChar(100)
  activo            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estadoProvincia   EstadoProvincia @relation(fields: [estadoProvinciaId], references: [id])
  codigosPostales   CodigoPostal[]
  direcciones       Direccion[]

  @@unique([estadoProvinciaId, nombre])
  @@index([estadoProvinciaId])
  @@index([activo])
  @@map("ciudades")
}

model CodigoPostal {
  id          String      @id @default(uuid()) @db.Uuid
  ciudadId    String      @db.Uuid
  codigo      String      @db.VarChar(10)
  latitud     Decimal?    @db.Decimal(11, 8)
  longitud    Decimal?    @db.Decimal(12, 8)
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ciudad      Ciudad      @relation(fields: [ciudadId], references: [id])
  direcciones Direccion[]

  @@unique([ciudadId, codigo])
  @@index([ciudadId])
  @@index([activo])
  @@map("codigos_postales")
}

model Direccion {
  id                  String             @id @default(uuid()) @db.Uuid
  paisId              String             @db.Uuid
  estadoProvinciaId   String             @db.Uuid
  ciudadId            String             @db.Uuid
  codigoPostalId      String             @db.Uuid
  alias               String?            @db.VarChar(100)
  calle               String             @db.VarChar(255)
  numeroExterior      String             @db.VarChar(30)
  numeroInterior      String?            @db.VarChar(30)
  colonia             String?            @db.VarChar(150)
  referencias         String?
  direccionFormateada String?
  latitud             Decimal            @db.Decimal(11, 8)
  longitud            Decimal            @db.Decimal(12, 8)
  googlePlaceId       String?            @db.VarChar(255)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  ciudad              Ciudad             @relation(fields: [ciudadId], references: [id])
  codigoPostal        CodigoPostal       @relation(fields: [codigoPostalId], references: [id])
  estadoProvincia     EstadoProvincia    @relation(fields: [estadoProvinciaId], references: [id])
  pais                Pais               @relation(fields: [paisId], references: [id])
  direccionesCliente  DireccionCliente[]
  pedidosEntrega      Pedido[]
  sucursal            Sucursal?

  @@index([paisId])
  @@index([estadoProvinciaId])
  @@index([ciudadId])
  @@index([codigoPostalId])
  @@index([googlePlaceId])
  @@map("direcciones")
}

model Sucursal {
  id                    String                  @id @default(uuid()) @db.Uuid
  direccionId           String                  @unique @db.Uuid
  codigo                String                  @unique @db.VarChar(50)
  nombre                String                  @db.VarChar(150)
  telefono              String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(255)
  activa                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  empleados             Empleado[]
  enviosDestino         Envio[]                 @relation("SucursalDestinoEnvio")
  enviosOrigen          Envio[]                 @relation("SucursalOrigenEnvio")
  eventosTracking       EventoTracking[]
  recepciones           RecepcionSucursal[]
  direccion             Direccion               @relation(fields: [direccionId], references: [id])
  transferenciasDestino TransferenciaSucursal[] @relation("TransferenciaDestino")
  transferenciasOrigen  TransferenciaSucursal[] @relation("TransferenciaOrigen")
  vehiculos             Vehiculo[]

  @@index([activa])
  @@map("sucursales")
}

model Empleado {
  id                  String              @id @default(uuid()) @db.Uuid
  usuarioId           String              @unique @db.Uuid
  sucursalId          String              @db.Uuid
  numeroEmpleado      String              @unique @db.VarChar(50)
  puesto              String              @db.VarChar(100)
  fechaIngreso        DateTime
  activo              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sucursal            Sucursal            @relation(fields: [sucursalId], references: [id])
  usuario             Usuario             @relation(fields: [usuarioId], references: [id])
  recepcionesSucursal RecepcionSucursal[]
  repartidor          Repartidor?

  @@index([sucursalId])
  @@index([activo])
  @@map("empleados")
}

model Repartidor {
  id                       String               @id @default(uuid()) @db.Uuid
  empleadoId               String               @unique @db.Uuid
  numeroLicencia           String               @unique @db.VarChar(100)
  fechaVencimientoLicencia DateTime?
  activo                   Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  asignacionesVehiculo     AsignacionVehiculo[]
  entregas                 Entrega[]
  empleado                 Empleado             @relation(fields: [empleadoId], references: [id])

  @@index([activo])
  @@map("repartidores")
}

model Vehiculo {
  id             String                  @id @default(uuid()) @db.Uuid
  sucursalId     String                  @db.Uuid
  placas         String                  @unique @db.VarChar(20)
  marca          String                  @db.VarChar(100)
  modelo         String                  @db.VarChar(100)
  anio           Int
  capacidadKg    Decimal                 @db.Decimal(10, 2)
  activo         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  asignaciones   AsignacionVehiculo[]
  sucursal       Sucursal                @relation(fields: [sucursalId], references: [id])
  transferencias TransferenciaSucursal[]

  @@index([sucursalId])
  @@index([activo])
  @@map("vehiculos")
}

model AsignacionVehiculo {
  id           String     @id @default(uuid()) @db.Uuid
  vehiculoId   String     @db.Uuid
  repartidorId String     @db.Uuid
  fechaInicio  DateTime
  fechaFin     DateTime?
  createdAt    DateTime   @default(now())
  repartidor   Repartidor @relation(fields: [repartidorId], references: [id])
  vehiculo     Vehiculo   @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId])
  @@index([repartidorId])
  @@index([fechaInicio])
  @@map("asignaciones_vehiculo")
}

model Cliente {
  id                  String              @id @default(uuid()) @db.Uuid
  usuarioId           String              @unique @db.Uuid
  /// Se crea (y se reutiliza) en el primer intento de pago; null hasta entonces.
  stripeCustomerId    String?             @unique @db.VarChar(255)
  activo              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  carrito             Carrito?
  usuario             Usuario             @relation(fields: [usuarioId], references: [id])
  direcciones         DireccionCliente[]
  pedidos             Pedido[]
  solicitudesVendedor SolicitudVendedor[]

  @@index([activo])
  @@map("clientes")
}

model DireccionCliente {
  id          String    @id @default(uuid()) @db.Uuid
  clienteId   String    @db.Uuid
  direccionId String    @db.Uuid
  esPrincipal Boolean   @default(false)
  createdAt   DateTime  @default(now())
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  direccion   Direccion @relation(fields: [direccionId], references: [id])

  @@unique([clienteId, direccionId])
  @@index([clienteId])
  @@map("direcciones_cliente")
}

model SolicitudVendedor {
  id                  String                  @id @default(uuid()) @db.Uuid
  clienteId           String                  @db.Uuid
  estado              EstadoSolicitudVendedor @default(PENDIENTE)
  comentariosRevision String?
  fechaRevision       DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  pasoActual          PasoSolicitudVendedor   @default(SOLICITUD)
  documentos          DocumentoVendedor[]
  informacionFiscal   InformacionFiscal?
  cliente             Cliente                 @relation(fields: [clienteId], references: [id])
  vendedorAprobado    Vendedor?

  @@index([clienteId])
  @@index([estado])
  @@map("solicitudes_vendedor")
}

model DocumentoVendedor {
  id                  String                @id @default(uuid()) @db.Uuid
  solicitudVendedorId String                @db.Uuid
  nombreArchivo       String                @db.VarChar(255)
  urlArchivo          String
  createdAt           DateTime              @default(now())
  tipoDocumento       TipoDocumentoVendedor
  solicitudVendedor   SolicitudVendedor     @relation(fields: [solicitudVendedorId], references: [id])

  @@index([solicitudVendedorId])
  @@map("documentos_vendedor")
}

model InformacionFiscal {
  id                  String            @id @default(uuid()) @db.Uuid
  solicitudVendedorId String            @unique @db.Uuid
  rfc                 String            @db.VarChar(20)
  razonSocial         String            @db.VarChar(255)
  regimenFiscal       String            @db.VarChar(255)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  solicitudVendedor   SolicitudVendedor @relation(fields: [solicitudVendedorId], references: [id])

  @@index([rfc])
  @@map("informacion_fiscal")
}

model Vendedor {
  id                  String                @id @default(uuid()) @db.Uuid
  usuarioId           String                @unique @db.Uuid
  solicitudAprobadaId String                @unique @db.Uuid
  estadoOperacionId   String?               @db.Uuid
  fechaAprobacion     DateTime
  activo              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  liquidaciones       LiquidacionVendedor[]
  pedidoItems         PedidoItem[]
  pedidoVendedores    PedidoVendedor[]
  tienda              Tienda?
  estadoOperacion     EstadoProvincia?      @relation(fields: [estadoOperacionId], references: [id])
  solicitudAprobada   SolicitudVendedor     @relation(fields: [solicitudAprobadaId], references: [id])
  usuario             Usuario               @relation(fields: [usuarioId], references: [id])

  @@index([activo])
  @@index([estadoOperacionId])
  @@map("vendedores")
}

model Tienda {
  id            String     @id @default(uuid()) @db.Uuid
  vendedorId    String     @unique @db.Uuid
  codigoPublico String     @unique @db.VarChar(50)
  nombre        String     @db.VarChar(255)
  descripcion   String?
  logoUrl       String?
  activa        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  productos     Producto[]
  vendedor      Vendedor   @relation(fields: [vendedorId], references: [id])

  @@index([activa])
  @@map("tiendas")
}

model Categoria {
  id          String      @id @default(uuid()) @db.Uuid
  parentId    String?     @db.Uuid
  nombre      String      @db.VarChar(150)
  slug        String      @unique @db.VarChar(150)
  descripcion String?
  activa      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Categoria?  @relation("CategoriaJerarquia", fields: [parentId], references: [id])
  hijos       Categoria[] @relation("CategoriaJerarquia")
  productos   Producto[]

  @@index([parentId])
  @@index([activa])
  @@map("categorias")
}

model Producto {
  id            String             @id @default(uuid()) @db.Uuid
  tiendaId      String             @db.Uuid
  categoriaId   String             @db.Uuid
  codigoPublico String             @unique @db.VarChar(50)
  nombre        String             @db.VarChar(255)
  descripcion   String?
  pesoKg        Decimal            @db.Decimal(10, 3)
  activo        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  publicado     Boolean            @default(false)
  altoCm        Decimal?           @db.Decimal(8, 2)
  anchoCm       Decimal?           @db.Decimal(8, 2)
  largoCm       Decimal?           @db.Decimal(8, 2)
  categoria     Categoria          @relation(fields: [categoriaId], references: [id])
  tienda        Tienda             @relation(fields: [tiendaId], references: [id])
  imagenes      ProductoImagen[]
  variantes     ProductoVariante[]

  @@index([tiendaId])
  @@index([categoriaId])
  @@index([activo])
  @@index([publicado])
  @@map("productos")
}

model ProductoImagen {
  id          String   @id @default(uuid()) @db.Uuid
  productoId  String   @db.Uuid
  url         String
  orden       Int
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  storageKey  String
  producto    Producto @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@map("productos_imagenes")
}

model Atributo {
  id        String          @id @default(uuid()) @db.Uuid
  nombre    String          @unique @db.VarChar(100)
  createdAt DateTime        @default(now())
  valores   ValorAtributo[]

  @@map("atributos")
}

model ValorAtributo {
  id         String                  @id @default(uuid()) @db.Uuid
  atributoId String                  @db.Uuid
  valor      String                  @db.VarChar(100)
  createdAt  DateTime                @default(now())
  variantes  ProductoVarianteValor[]
  atributo   Atributo                @relation(fields: [atributoId], references: [id])

  @@unique([atributoId, valor])
  @@index([atributoId])
  @@map("valores_atributo")
}

model ProductoVariante {
  id           String                  @id @default(uuid()) @db.Uuid
  productoId   String                  @db.Uuid
  sku          String                  @unique @db.VarChar(100)
  precio       Decimal                 @db.Decimal(12, 2)
  pesoKg       Decimal?                @db.Decimal(10, 3)
  activa       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  carritoItems CarritoItem[]
  inventario   Inventario?
  pedidoItems  PedidoItem[]
  producto     Producto                @relation(fields: [productoId], references: [id])
  valores      ProductoVarianteValor[]

  @@index([productoId])
  @@index([activa])
  @@map("productos_variantes")
}

model Inventario {
  id                 String           @id @default(uuid()) @db.Uuid
  productoVarianteId String           @unique @db.Uuid
  stockDisponible    Int              @default(0)
  stockReservado     Int              @default(0)
  stockMinimo        Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  productoVariante   ProductoVariante @relation(fields: [productoVarianteId], references: [id])

  @@index([stockDisponible])
  @@map("inventarios")
}

model ProductoVarianteValor {
  productoVarianteId String           @db.Uuid
  valorAtributoId    String           @db.Uuid
  productoVariante   ProductoVariante @relation(fields: [productoVarianteId], references: [id])
  valorAtributo      ValorAtributo    @relation(fields: [valorAtributoId], references: [id])

  @@id([productoVarianteId, valorAtributoId])
  @@map("productos_variantes_valores")
}

model Carrito {
  id        String        @id @default(uuid()) @db.Uuid
  clienteId String        @unique @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cliente   Cliente       @relation(fields: [clienteId], references: [id])
  items     CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id                 String           @id @default(uuid()) @db.Uuid
  carritoId          String           @db.Uuid
  productoVarianteId String           @db.Uuid
  cantidad           Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  carrito            Carrito          @relation(fields: [carritoId], references: [id])
  productoVariante   ProductoVariante @relation(fields: [productoVarianteId], references: [id])

  @@unique([carritoId, productoVarianteId])
  @@index([carritoId])
  @@index([productoVarianteId])
  @@map("carritos_items")
}

model Pedido {
  id                  String           @id @default(uuid()) @db.Uuid
  clienteId           String           @db.Uuid
  direccionEntregaId  String           @db.Uuid
  codigoPedido        String           @unique @db.VarChar(50)
  estado              EstadoPedido     @default(PENDIENTE_PAGO)
  subtotal            Decimal          @db.Decimal(12, 2)
  costoEnvio          Decimal          @db.Decimal(12, 2)
  comisionCorreosClic Decimal          @db.Decimal(12, 2)
  totalVendedores     Decimal          @db.Decimal(12, 2)
  total               Decimal          @db.Decimal(12, 2)
  fechaPago           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  pagos               Pago[]
  cliente             Cliente          @relation(fields: [clienteId], references: [id])
  direccionEntrega    Direccion        @relation(fields: [direccionEntregaId], references: [id])
  items               PedidoItem[]
  pedidoVendedores    PedidoVendedor[]
  reembolsos          Reembolso[]

  @@index([clienteId])
  @@index([estado])
  @@index([fechaPago])
  @@map("pedidos")
}

/// Porción de un Pedido que corresponde a un vendedor específico.
/// Es una entidad de dominio propia (no solo un desglose financiero): será el
/// punto de anclaje para Logistics (Envio.pedidoVendedorId a futuro),
/// Payments/Payouts y devoluciones parciales por vendedor.
///
/// Pedido.estado representa la compra completa del cliente; a futuro se
/// derivará agregando los EstadoPedidoVendedor de todos sus PedidoVendedor
/// (ej. todos PENDIENTE_PAGO -> Pedido PENDIENTE_PAGO; estados mixtos ->
/// Pedido EN_PROCESO; todos ENTREGADO -> Pedido ENTREGADO). Esa lógica de
/// transición no se implementa todavía.
model PedidoVendedor {
  id         String @id @default(uuid()) @db.Uuid
  pedidoId   String @db.Uuid
  vendedorId String @db.Uuid

  estado EstadoPedidoVendedor @default(PENDIENTE_PAGO)

  /// Snapshot financiero, inmutable una vez creado.
  subtotal            Decimal @db.Decimal(12, 2)
  costoEnvioAsignado  Decimal @db.Decimal(12, 2)
  comisionMarketplace Decimal @db.Decimal(12, 2)
  /// subtotal + costoEnvioAsignado. NO resta comisionMarketplace: representa
  /// la porción del pago del cliente, no lo que se liquidará al vendedor.
  totalPedido         Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
