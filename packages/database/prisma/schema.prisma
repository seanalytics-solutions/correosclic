/// Registro de idempotencia genérico (inspirado en Stripe), reutilizable por
/// cualquier operación crítica que no deba ejecutarse dos veces por reintentos
/// de red o doble clic (Orders hoy, Payments/Payouts después).
///
/// El cliente (web/móvil) genera un UUID por intento de operación y lo manda
/// en el header Idempotency-Key. huellaSolicitud es un hash del body: si la
/// misma clave llega con un body distinto, es un error del cliente (reusó la
/// clave para otra operación), no un reintento legítimo.
model IdempotencyKey {
  id              String             @id @default(uuid()) @db.Uuid
  usuarioId       String             @db.Uuid
  /// Valor del header Idempotency-Key.
  clave           String             @db.VarChar(255)
  /// "METODO:ruta" (ej. "POST:/orders"), para que la misma clave no choque
  /// entre operaciones distintas.
  ruta            String             @db.VarChar(255)
  huellaSolicitud String             @db.VarChar(64)
  estado          EstadoIdempotencia @default(EN_PROCESO)
  statusCode      Int?
  /// Respuesta cacheada para reproducirla tal cual en reintentos.
  respuesta       Json?
  createdAt       DateTime           @default(now())
  completadoEn    DateTime?
  usuario         Usuario            @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, clave, ruta])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("idempotency_keys")
}

